#!/bin/sh
set -eu

VERSION=0.1.0
self=$(readlink -f "$0")
here=$(dirname "$self")
# A source checkout keeps lib/ beside this script; an install puts it under share/.
lib=$here/lib
[ -d "$lib/rgss" ] || lib=$here/../share/tuxtavern

die() { printf 'tt: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
# How to install package $1 with this system's package manager (the names asked for are the same
# on Alpine, Debian, Fedora, Arch and openSUSE).
pkg_cmd() {
	for manager in 'apk add' 'apt-get install' 'dnf install' 'pacman -S' 'zypper install'; do
		have "${manager%% *}" && { printf '%s %s' "$manager" "$1"; return; }
	done
	printf 'install %s' "$1"
}
# How to install TuxTavern's MV/MZ runtime from a checkout.
pmjs_hint() { if have apk; then printf 'doas sh tools/apk.sh'; else printf 'sh tools/install.sh'; fi; }
# And mkxp-z, built by the same scripts.
mkxpz_hint() { printf '%s -m' "$(pmjs_hint)"; }
# An install keeps pmjs beside this script (in a checkout, pmjs/ is its source).
pmjs=$here/pmjs
{ [ -f "$pmjs" ] && [ -x "$pmjs" ]; } || pmjs=$(command -v pmjs 2>/dev/null || true)
# And mkxp-z in lib/mkxp-z (install.sh -m).
mkxpz=
for f in "$here"/../lib/mkxp-z/mkxp-z.*; do [ -f "$f" ] && [ -x "$f" ] && mkxpz=$(cd "${f%/*}" && pwd -P)/${f##*/}; done
ci_glob() { printf '%s\n' "$1" | awk '{ for (i = 1; i <= length($0); i++) { c = substr($0, i, 1); u = toupper(c); l = tolower(c); printf "%s", (u != l ? "[" l u "]" : c) } }'; }
find_ci() {
	# shellcheck disable=SC2046
	for f in "$game"/$(ci_glob "$1"); do
		[ -e "$f" ] && { printf '%s\n' "${f#"$game"/}"; return 0; }
	done
	return 0
}
game_mkxp() { find_ci mkxp.json; }
has() { [ -n "$(find_ci "$1")" ]; }
# A packed game's exe: Enigma Virtual Box, or NW.js with the game zipped onto its end.
packed_exe() {
	for f in "$game"/*.[eE][xX][eE]; do
		[ -f "$f" ] || continue
		if head -c 4096 "$f" | tr '\000' '\n' | grep -qF .enigma1; then packing='Enigma Virtual Box'
		elif have node && [ "$(node "$lib/evb.js" --nwjs "$f" 2>/dev/null)" = yes ]; then packing='NW.js package'
		else continue
		fi
		echo "$f"; return 0
	done
	return 1
}

usage() {
	cat <<EOF
Usage: tt [-T | -C | -i | -d] [GAME_DIR | GAME.exe]
       tt -e SAVE_FILE

Runs a Windows RPG Maker XP/VX/VX Ace/MV/MZ game natively (default: the current directory).

  -T, --test      XP/VX/VX Ace: playtest mode (F9 debug menu)
  -C, --no-cheat  turn off the F8 cheat menu (on by default)
  -i, --info      show what was detected
  -d, --desktop   add the game to the app launcher
  -e, --edit-save open a save as JSON in \$EDITOR, write it back on exit
  -h, --help      show this help
  -V, --version   show the version

Games run on Wayland only. RTPs go in ~/.local/share/tuxtavern/rtp/ (XP: Standard;
VX: RPGVX; VX Ace: RPGVXAce). Environment: TUXTAVERN_SKIP (plugins or scripts to leave out,
e.g. ones that build HTML), TUXTAVERN_DUMP_SCRIPTS=DIR (XP/VX/VX Ace: write the game's
scripts there), TUXTAVERN_RGSS_SKIP (shims to leave out), TUXTAVERN_YJIT=1
(XP/VX/VX Ace: try Ruby's JIT compiler; experimental, x86-64 only), TUXTAVERN_SCREENSHOTS
(MV/MZ: F12 saves a screenshot; 1 for ~/Pictures, or a folder), TUXTAVERN_KEYS (MV/MZ:
extra keys, e.g. wasd or w=up,e=ok,q=cancel; XP/VX/VX Ace: mkxp-z's F1), TUXTAVERN_OVERRIDES
(MV/MZ: a mod's files read instead of the game's, e.g. data:.json=.pack), TUXTAVERN_SAVE_DIRS
(MV/MZ: other folders the game saves in, kept with its saves). Settings for one
game go in its folder's tuxtavern.env, one NAME=value per line.
EOF
}

mode=run test='' cheat=1 nocheat=''
while [ $# -gt 0 ]; do
	case $1 in
	-T | --test) test=1 ;;
	-C | --no-cheat) cheat='' ;;
	-i | --info) mode=info ;;
	-d | --desktop) mode=desktop ;;
	-e | --edit-save) mode=edit-save ;;
	-h | --help) usage; exit 0 ;;
	-V | --version) echo "tt $VERSION"; exit 0 ;;
	--) shift; break ;;
	-*) die "unknown option $1 (see --help)" ;;
	*) break ;;
	esac
	shift
done
[ $# -le 1 ] || die "expected one game path (see --help)"
target=${1:-.}
[ -e "$target" ] || die "no such file or directory: $target"

if [ "$mode" = edit-save ]; then
	[ -f "$target" ] || die "--edit-save takes a save file, e.g. www/save/file1.rpgsave or Save01.rvdata2"
	have node || die "--edit-save needs node ($(pkg_cmd nodejs))"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT INT TERM
	node "$lib/savejson.js" decode "$target" "$tmp/save.json" || exit 1
	cp "$tmp/save.json" "$tmp/before.json"
	# shellcheck disable=SC2086
	${EDITOR:-vi} "$tmp/save.json"
	if cmp -s "$tmp/save.json" "$tmp/before.json"; then echo "Unchanged; nothing written."; exit 0; fi
	if ! node "$lib/savejson.js" encode "$tmp/save.json" "$target"; then
		cp "$tmp/save.json" "$target.json"
		die "not written; your edit is kept in $target.json"
	fi
	echo "Wrote $target (the original is kept as $target.bak)"
	exit 0
fi
[ -d "$target" ] || target=$(dirname "$target")
game=$(cd "$target" && pwd -P)
# The game folder's tuxtavern.env: NAME=value lines, read as data, not run. Only PMJS_*,
# TUXTAVERN_* and SDL_* names; what the environment already sets wins.
settings=$(find_ci tuxtavern.env)
if [ -n "$settings" ] && [ -f "$game/$settings" ]; then
	settings=$game/$settings
	while IFS= read -r line || [ -n "$line" ]; do
		line=$(printf %s "$line" | tr -d '\r')
		case $line in '' | '#'*) continue ;; esac
		name=${line%%=*}
		case $name in
		*[!A-Za-z0-9_]* | '') ;;
		PMJS_* | TUXTAVERN_* | SDL_*)
			[ "$name" != "$line" ] || { echo "tt: $settings: no '=' in: $line" >&2; continue; }
			eval "given=\${$name+x}"
			[ -n "$given" ] || export "$name=${line#*=}"
			continue ;;
		esac
		echo "tt: $settings: only PMJS_*, TUXTAVERN_* and SDL_* are read, not: $line" >&2
	done <"$settings"
else
	settings=
fi
nw=$(find_ci package.nw)
[ -z "$nw" ] || [ ! -d "$game/$nw" ] || game=$(cd "$game/$nw" && pwd -P)
data="${XDG_DATA_HOME:-$HOME/.local/share}/tuxtavern"
id=$(printf %s "$game" | md5sum | cut -c1-12)
unpacked="$data/unpacked/$id"
rtp="$data/rtp"

if has www/js/rpg_core.js || has js/rpg_core.js; then engine='mv'
elif has js/rmmz_core.js; then engine='mz'
elif has package.nw; then engine='nwjs-zip'
elif has 'data/*.r?data*' || { has game.ini && has 'game.rgss*'; }; then engine='rgss'
elif packed=$(packed_exe); then engine='evb'
else engine=
fi

# mkxp-z's own Ruby scripts (win32_wrap.rb and others), which lib/rgss/all.rb loads.
mkxp_preload_dir() {
	[ -n "$mkxpz" ] && [ -f "${mkxpz%/*}/scripts/preload/win32_wrap.rb" ] && echo "${mkxpz%/*}/scripts/preload"
}
rtp_names() {
	ini=$(find_ci game.ini)
	[ -z "$ini" ] || tr -d '\r' <"$game/$ini" | sed -n 's/^RTP[1-3]\{0,1\} *= *\(..*\)$/\1/p'
}
# MV/MZ's gameTitle or XP/VX/VX Ace's Game.ini Title, else the folder name. Game.ini is often
# Shift-JIS, and names must be UTF-8, so only a plain ASCII title from there.
game_title() {
	name=
	case $engine in
	mv | mz)
		system=$(find_ci www/data/System.json)
		[ -n "$system" ] || system=$(find_ci data/System.json)
		[ -z "$system" ] || name=$(sed -n 's/.*"gameTitle" *: *"\([^"\\]*\)".*/\1/p' "$game/$system" | head -n 1) ;;
	rgss)
		ini=$(find_ci game.ini)
		[ -z "$ini" ] || name=$(tr -d '\r' <"$game/$ini" | sed -n 's/^Title *= *//p' | head -n 1 | LC_ALL=C grep -v '[^ -~]' || :) ;;
	esac
	[ -n "$name" ] || name=$(basename "$game")
	printf '%s\n' "$name"
}
json() { printf '"%s"' "$(printf %s "$1" | sed 's/[\\"]/\\&/g')"; }
# One Exec argument of a .desktop file: quoted, its \ " ` $ escaped, then escaped again as a string.
desktop_arg() { printf '"%s"' "$(printf %s "$1" | sed -e 's/\\/\\\\\\\\/g' -e 's/["`$]/\\\\&/g' -e 's/%/%%/g')"; }

case $mode in
info)
	echo "tt: $VERSION"
	echo "game:    $game"
	echo "engine:  ${engine:-not recognized}"
	[ -z "$settings" ] || echo "settings: $settings"
	core=$(find_ci www/js/rpg_core.js)
	[ -n "$core" ] || core=$(find_ci js/rpg_core.js)
	[ -n "$core" ] || core=$(find_ci js/rmmz_core.js)
	[ -z "$core" ] || sed -n "s/^Utils\.RPGMAKER_VERSION *= *.\([0-9.]*\).*/version: \1/p" "$game/$core"
	case $engine in
	'') ;;
	evb) echo "packed:  $(basename "$packed") ($(packed_exe >/dev/null; echo "$packing")), unpacked on first run to $unpacked" ;;
	nwjs-zip) echo "packed:  $(find_ci package.nw), unpacked on first run to $unpacked" ;;
	rgss)
		if [ -n "$mkxpz" ]; then
			# tools/install.sh records the mkxp-z it built beside the preload scripts.
			built=$(cat "$(mkxp_preload_dir || echo /nonexistent)/../../VERSION" 2>/dev/null || true)
			echo "runtime: $mkxpz${built:+ ($built)}"
		else echo "runtime: mkxp-z not installed ($(mkxpz_hint) in a TuxTavern checkout)"
		fi
		echo "config:  written by tt to $data/mkxp/$id"
		[ -z "$(game_mkxp)" ] || echo "         merged with the game's $(game_mkxp)"
		rtp_names | while read -r name; do
			if [ -d "$rtp/$name" ]; then echo "rtp:     $name, installed"; else echo "rtp:     $name, not installed in $rtp/$name"; fi
		done ;;
	mv | mz)
		if [ -n "$pmjs" ]; then echo "runtime: $pmjs ($("$pmjs" --version 2>/dev/null || echo 'version unknown'))"
		else echo "runtime: pmjs not installed ($(pmjs_hint) in a TuxTavern checkout)"
		fi
		www=$(find_ci www)
		pixi=$(find_ci "${www:+$www/}js/libs/pixi.js")
		if [ -n "$pixi" ]; then
			v=$(head -c 4096 "$game/$pixi" | sed -n 's/.*pixi\.js - v\([0-9][0-9.]*\).*/\1/p' | head -n 1)
			[ -n "$v" ] || v=$(grep -o "VERSION *= *[\"'][0-9][0-9.]*" "$game/$pixi" | head -n 1 | sed "s/.*[\"']//")
			echo "pixi:    ${v:-unknown}"
		fi
		plugins=$(find_ci "${www:+$www/}js/plugins.js")
		[ -z "$plugins" ] || echo "plugins: $(grep -o '"status" *: *true' "$game/$plugins" | wc -l | tr -d ' ') of $(grep -oE '"status" *: *(true|false)' "$game/$plugins" | wc -l | tr -d ' ') on" ;;
	esac
	exit 0 ;;
desktop)
	[ -n "$engine" ] || die "no RPG Maker XP/VX/VX Ace/MV/MZ game found in $game"
	name=$(game_title)
	icon=$(find_ci www/icon/icon.png)
	[ -n "$icon" ] || icon=$(find_ci icon/icon.png)
	apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
	mkdir -p "$apps" || die "cannot create $apps"
	{
		printf '[Desktop Entry]\nType=Application\nName=%s\nExec=%s %s\n' "$(printf %s "$name" | sed 's/\\/\\\\/g')" \
			"$(desktop_arg "$self")" "$(desktop_arg "$game")"
		[ -z "${icon:-}" ] || printf 'Icon=%s\n' "$game/$icon"
		printf 'Categories=Game;\nTerminal=false\n'
	} >"$apps/tuxtavern-$id.desktop" || die "cannot write $apps/tuxtavern-$id.desktop"
	echo "Added $name to the app launcher: $apps/tuxtavern-$id.desktop (delete it to remove)"
	exit 0 ;;
esac

[ -n "${WAYLAND_DISPLAY:-}" ] || die "TuxTavern runs games on Wayland only, and WAYLAND_DISPLAY is not set"
# shellcheck disable=SC3045
ulimit -n "$(ulimit -H -n)" 2>/dev/null || true

# MV/MZ on PMJS. Saves go to the game's save folder, where NW.js keeps them; PMJS's asset
# cache to ours.
run_pmjs() {
	[ -n "$pmjs" ] || die "MV/MZ games need pmjs ($(pmjs_hint) in a TuxTavern checkout)"
	[ -z "$test" ] || echo "tt: -T works for XP/VX/VX Ace games only" >&2
	dir=$game
	www=$(find_ci www)
	[ -z "$www" ] || [ ! -d "$game/$www/js" ] || dir="$game/$www"
	cache="${XDG_CACHE_HOME:-$HOME/.cache}/tuxtavern/pmjs/$id"
	mkdir -p "$cache" || die "cannot create $cache"
	files=$(virtual_files) || exit 1
	printf '{ "assetPreparation": { "cacheRoot": %s }%s }\n' "$(json "$cache/assets")" "$files" >"$cache/config.json"
	set -- --game "$dir" --config "$cache/config.json"
	skip=
	for name in $(printf '%s' "${TUXTAVERN_SKIP:-}" | tr ',' ' '); do skip="$skip${skip:+, }$(json "$name")"; done
	shots=${TUXTAVERN_SCREENSHOTS:-}
	[ "$shots" != 1 ] || shots=$HOME/Pictures
	# The game folder's *.tuxtavern.js: for a packed game, the folder it was unpacked from. Their
	# text goes into the adapter, as PMJS lets the game read only its own folder (www/ for MV).
	user=
	for f in "${TUXTAVERN_GAME_DIR:-$game}"/$(ci_glob '*.tuxtavern.js'); do
		[ -f "$f" ] && user="$user${user:+, }{ file: $(json "$f"), source: \"$(tr -d '\r' <"$f" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/$/\\n/' | tr -d '\n')\" }"
	done
	keys=${TUXTAVERN_KEYS:-}
	if [ -n "$cheat$skip$shots$user$keys" ]; then
		pmjs_adapter "$skip" >"$cache/tuxtavern.js" || die "cannot write $cache/tuxtavern.js"
		set -- "$@" --adapter "$cache/tuxtavern.js"
	fi
	"$pmjs" prepare "$@" >&2 || exit 1
	export SDL_VIDEODRIVER=wayland
	exec "$pmjs" run --game "$dir" --save-root "$dir/save"
}

# PMJS's virtualFiles, as a config member: TUXTAVERN_OVERRIDES (folder:.ext=.new,..., a mod's file
# read instead of the game's when present) and TUXTAVERN_SAVE_DIRS (folders kept with the saves).
virtual_files() {
	[ -n "${TUXTAVERN_OVERRIDES:-}${TUXTAVERN_SAVE_DIRS:-}" ] || return 0
	printf '%s\n%s\n' "${TUXTAVERN_OVERRIDES:-}" "${TUXTAVERN_SAVE_DIRS:-}" | awk '
		function str(s) { gsub(/[\\"]/, "\\\\&", s); return "\"" s "\"" }
		NR == 1 && $0 != "" {
			n = split($0, rules, ",")
			for (i = 1; i <= n; i++) {
				r = rules[i]; c = index(r, ":"); e = index(r, "=")
				if (!c || e < c + 3 || substr(r, c + 1, 1) != "." || e == length(r)) {
					print "tt: TUXTAVERN_OVERRIDES: cannot read " r " (use folder:.ext=.new, e.g. data:.json=.pack)" >"/dev/stderr"; bad = 1; continue
				}
				dir = substr(r, 1, c - 1)
				if (!(dir in seen)) { seen[dir] = 1; dirs[++count] = dir }
				rule[dir] = rule[dir] (rule[dir] == "" ? "" : ", ") str(substr(r, c + 1, e - c - 1)) ": " str(substr(r, e + 1))
			}
		}
		NR == 2 && $0 != "" {
			n = split($0, list, ",")
			for (i = 1; i <= n; i++) saves = saves (saves == "" ? "" : ", ") str(list[i])
		}
		END {
			if (bad) exit 1
			for (i = 1; i <= count; i++) over = over (i > 1 ? ", " : "") str(dirs[i]) ": { " rule[dirs[i]] " }"
			out = (over == "" ? "" : "\"overrides\": { " over " }")
			if (saves != "") out = out (out == "" ? "" : ", ") "\"saveDirectories\": [" saves "]"
			printf ", \"virtualFiles\": { %s }", out
		}'
}

# The one PMJS adapter: the plugins to leave out ($1, JSON strings), switched off before any
# loads (a name matches with or without its folder), and the cheat menu.
pmjs_adapter() {
	# shellcheck disable=SC2016
	[ -z "$1" ] || printf 'PMJS.phases.on("beforePlugins", "tuxtavern.skip", function () {\n\tvar skip = [%s];\n\t$plugins.forEach(function (p) {\n\t\tif (p.status && (skip.indexOf(p.name) >= 0 || skip.indexOf(p.name.split("/").pop()) >= 0)) {\n\t\t\tp.status = false;\n\t\t\tconsole.log("tt: TUXTAVERN_SKIP leaves out " + p.name);\n\t\t}\n\t});\n});\n' "$1"
	# User scripts run once the game's plugins have loaded, as plugin scripts do (global scope), and
	# before the cheat menu hooks in, so they cannot undo it.
	# shellcheck disable=SC2016
	[ -z "$user" ] || printf 'PMJS.phases.on("afterGuestPlugins", "tuxtavern.user", function () {\n\t[%s].forEach(function (u) {\n\t\ttry {\n\t\t\t(0, eval)(u.source + "\\n//# sourceURL=" + u.file);\n\t\t\tconsole.log("tt: " + u.file + " ran");\n\t\t} catch (e) {\n\t\t\tconsole.log("tt: " + u.file + " failed: " + (e && e.stack || e));\n\t\t}\n\t});\n});\n' "$user"
	[ -z "$cheat" ] || pmjs_cheats
	[ -z "$shots" ] || pmjs_screenshots
	[ -z "$keys" ] || pmjs_keys
}

# The cheat menu: editor.js's model, the on-screen menu, and the hook that installs them
# once the game's plugins have loaded.
pmjs_cheats() {
	printf '(function () {\nvar editor = (function () { var module = { exports: {} };\n'
	cat "$lib/editor.js"
	printf '\nreturn module.exports; })();\nvar cheats = (function () { var module = { exports: {} };\n'
	cat "$lib/pmjs-cheats.js"
	printf '\nreturn module.exports; })();\n'
	printf "PMJS.phases.on('afterGuestPlugins', 'tuxtavern.cheats', function () { cheats.install(globalThis, editor); });\n})();\n"
}

# TUXTAVERN_KEYS: extra key mappings.
pmjs_keys() {
	printf '(function () {\nvar keys = (function () { var module = { exports: {} };\n'
	cat "$lib/pmjs-keys.js"
	printf '\nreturn module.exports; })();\n'
	printf "PMJS.phases.on('afterGuestPlugins', 'tuxtavern.keys', function () { keys.install(globalThis, %s); });\n})();\n" "$(json "$keys")"
}

# F12 saves a screenshot, named after the game, to $shots.
pmjs_screenshots() {
	printf '(function () {\nvar shots = (function () { var module = { exports: {} };\n'
	cat "$lib/pmjs-screenshot.js"
	printf '\nreturn module.exports; })();\n'
	printf "PMJS.phases.on('afterGuestPlugins', 'tuxtavern.screenshots', function () { shots.install(globalThis, %s, %s); });\n})();\n" \
		"$(json "$shots")" "$(json "$(game_title | tr '/' '_')")"
}

case $engine in
mv | mz) run_pmjs ;;
nwjs-zip | evb)
	have node || die "unpacking this game needs node ($(pkg_cmd nodejs))"
	[ "$engine" = evb ] || packed="$game/$(find_ci package.nw)"
	if [ ! -f "$unpacked/.tuxtavern-unpacked" ] || [ -n "$(find "$packed" -newer "$unpacked/.tuxtavern-unpacked")" ]; then
		mkdir -p "$unpacked" || die "cannot create $unpacked"
		node "$lib/evb.js" "$packed" "$unpacked" || exit 1
		touch "$unpacked/.tuxtavern-unpacked"
	fi
	[ -n "$cheat" ] || nocheat=1
	export TUXTAVERN_GAME_DIR="$game"
	exec sh "$self" ${test:+--test} ${nocheat:+--no-cheat} "$unpacked" ;;
rgss)
	[ -n "$mkxpz" ] || die "XP/VX/VX Ace games need mkxp-z ($(mkxpz_hint) in a TuxTavern checkout)"
	pre=$(mkxp_preload_dir || true)
	[ -z "$pre" ] || export TUXTAVERN_MKXPZ_PRELOAD="$pre"
	scripts=$(find_ci 'data/scripts.r*data*')
	[ -n "$scripts" ] || scripts=$(find_ci 'game.rgss*')
	case $(printf %s "$scripts" | tr '[:upper:]' '[:lower:]') in
	*.rxdata | *.rgssad) rgss=1 ;; *.rvdata | *.rgss2a) rgss=2 ;; *) rgss=3 ;;
	esac
	conf="$data/mkxp/$id"
	mkdir -p "$conf" || die "cannot create $conf"
	paths=''
	for name in $(rtp_names); do
		if [ -d "$rtp/$name" ]; then paths="$paths${paths:+, }$(json "$rtp/$name")"
		else echo "tt: the game names the $name RTP; if graphics or sounds are missing, extract it to $rtp/$name" >&2
		fi
	done
	stdlib=''
	[ -z "$pre" ] || [ ! -d "$pre/../../stdlib" ] || stdlib=$(json "$(cd "$pre/../../stdlib" && pwd -P)")
	# Built with the system's Ruby (tools/install.sh -r): its library folders.
	if [ -z "$stdlib" ] && [ -n "$pre" ] && [ -f "$pre/../../loadpath" ]; then
		while read -r dir; do [ -z "$dir" ] || stdlib="$stdlib${stdlib:+, }$(json "$dir")"; done <"$pre/../../loadpath"
	fi
	keys="\"gameFolder\": $(json "$game"), \"preloadScript\": [$(json "$lib/rgss/all.rb")], \"enableReset\": false, \"RTP\": [$paths], \"rubyLoadpath\": [$stdlib]"
	if [ -n "${TUXTAVERN_YJIT:-}" ]; then
		keys="$keys, \"YJITEnable\": true"
		[ "$(uname -m)" = x86_64 ] || echo "tt: TUXTAVERN_YJIT needs x86-64; mkxp-z's Ruby 3.1 has no YJIT on $(uname -m)" >&2
	fi
	own=$(game_mkxp)
	if [ -n "$own" ] && K="$keys," awk '!done && /^[ \t]*\{/ { i = index($0, "{"); $0 = substr($0, 1, i) " " ENVIRON["K"] substr($0, i + 1); done = 1 } { print } END { exit !done }' "$game/$own" >"$conf/mkxp.json"; then
		! grep -v '^[[:space:]]*//' "$game/$own" | grep -q '"preloadScript"' || echo "tt: $own sets its own preloadScript, so TuxTavern's fixes are left out" >&2
	else
		[ -z "$own" ] || echo "tt: cannot read $own; its settings are left out" >&2
		printf '{\n\t%s\n}\n' "$keys" >"$conf/mkxp.json" || die "cannot write $conf/mkxp.json"
	fi
	cd "$conf"
	export SDL_VIDEODRIVER=wayland SRCDIR="$conf" TUXTAVERN_SHIM_DIR="$lib/rgss" TUXTAVERN_RGSS_VERSION="$rgss" TUXTAVERN_CHEAT="$cheat"
	if [ -n "$test" ]; then exec "$mkxpz" test; else exec "$mkxpz"; fi ;;
*) die "no RPG Maker XP/VX/VX Ace/MV/MZ game found in $game" ;;
esac
